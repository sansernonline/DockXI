<Window x:Class="DockXI.UI.MainDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
        xmlns:local="clr-namespace:DockXI.UI"
        mc:Ignorable="d"
        x:Name="DockWindow"
        Title="DockXI"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MinWidth="0"
        MinHeight="0"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="OnLoaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <SineEase x:Key="EaseOut" EasingMode="EaseOut" />
        <SineEase x:Key="EaseIn"  EasingMode="EaseIn" />

        <!-- Tooltip overlay: dark rounded pill matching the dock plate /
             context-menu theme, so the label stays readable over ANY
             background (a bare white-text-plus-shadow version was unreadable
             on light windows underneath). Placement=Top so the label hovers
             above the lifted tile. -->
        <Style x:Key="TooltipOverlayStyle" TargetType="ToolTip">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HasDropShadow"   Value="False" />
            <Setter Property="Placement"       Value="Top" />
            <Setter Property="VerticalOffset"  Value="-2" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <!-- Margin gives the soft shadow room to render
                             instead of being clipped at the popup bounds. -->
                        <Border Background="#E8202020"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9,4,9,5"
                                Margin="6"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1"
                                                  Direction="270"
                                                  Color="Black" Opacity="0.45" />
                            </Border.Effect>
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ===== Win11-style dark ContextMenu ============================ -->
        <SolidColorBrush x:Key="MenuBg"        Color="#2C2C2C" />
        <SolidColorBrush x:Key="MenuBorder"    Color="#3F3F3F" />
        <SolidColorBrush x:Key="MenuFg"        Color="#F2F2F2" />
        <SolidColorBrush x:Key="MenuHover"     Color="#3E3E3E" />
        <SolidColorBrush x:Key="MenuSeparator" Color="#3F3F3F" />

        <Style x:Key="DockContextMenuStyle" TargetType="ContextMenu">
            <!-- Force LTR so the menu doesn't inherit the RTL FlowDirection
                 set on Right-edge tiles (which would mirror "Add file..." →
                 "...Add file", flip submenu arrow, etc.). -->
            <Setter Property="FlowDirection"       Value="LeftToRight" />
            <Setter Property="Background"          Value="{StaticResource MenuBg}" />
            <Setter Property="BorderBrush"         Value="{StaticResource MenuBorder}" />
            <Setter Property="BorderThickness"     Value="1" />
            <Setter Property="Foreground"          Value="{StaticResource MenuFg}" />
            <Setter Property="FontFamily"          Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize"            Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding"   Value="True" />
            <Setter Property="HasDropShadow"       Value="True" />
            <Setter Property="Padding"             Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockMenuItemStyle" TargetType="MenuItem">
            <!-- Belt-and-braces LTR — ContextMenu's FlowDirection setter
                 propagates here, but explicit setter handles edge cases where
                 a MenuItem becomes the popup-host for a submenu. -->
            <Setter Property="FlowDirection"       Value="LeftToRight" />
            <Setter Property="Background"          Value="Transparent" />
            <Setter Property="Foreground"          Value="{StaticResource MenuFg}" />
            <Setter Property="Padding"             Value="12,6" />
            <Setter Property="Margin"              Value="0,1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Check"
                                      Grid.Column="0"
                                      Data="M2,7 L6,11 L13,3"
                                      Stroke="{StaticResource MenuFg}"
                                      StrokeThickness="1.6"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  Margin="4,0,8,0" />
                                <Path x:Name="Chevron"
                                      Grid.Column="2"
                                      Data="M0,0 L4,4 L0,8"
                                      Stroke="{StaticResource MenuFg}"
                                      StrokeThickness="1.2"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center"
                                      Margin="8,0,0,0" />
                                <Popup x:Name="PART_Popup"
                                       Placement="Right"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <Border CornerRadius="8"
                                            Background="{StaticResource MenuBg}"
                                            BorderBrush="{StaticResource MenuBorder}"
                                            BorderThickness="1"
                                            Padding="4"
                                            SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#808080" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DockSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource MenuSeparator}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Tile button (hover lift) ================================ -->
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="0" />
            <!-- Margin only on the LONG axis (between tiles); cross-axis is
                 0 so icons sit flush against the plate edges with no
                 asymmetric gap. -->
            <Setter Property="Margin"          Value="{Binding ElementName=DockWindow, Path=TileMargin}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
<EventTrigger RoutedEvent="Button.Click">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                To="0" Duration="0:0:0.14"
                                FillBehavior="Stop"
                                EasingFunction="{StaticResource EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    To="-5" Duration="0:0:0.24"
                                    EasingFunction="{StaticResource EaseOut}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    To="0" Duration="0:0:0.24"
                                    EasingFunction="{StaticResource EaseIn}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Single shared dock context menu. Used for BOTH the empty plate
             (right-click on whitespace) and per-tile right-click. When opened
             from a tile, DockMenu_Opened injects a "Delete \"<name>\"" item
             at the top so the user gets all the dock settings PLUS the
             item-specific delete in a single menu. x:Shared=False so each
             ContextMenu attached site gets a separate instance — a
             ContextMenu can't be a logical child of two parents. -->
        <ContextMenu x:Key="DockMenu" x:Shared="False"
                     Opened="DockMenu_Opened"
                     Closed="DockMenu_Closed"
                     FlowDirection="LeftToRight"
                     Style="{StaticResource DockContextMenuStyle}"
                     Foreground="{StaticResource MenuFg}">
            <MenuItem Header="Add file..."   Click="PinFile_Click"      Style="{StaticResource DockMenuItemStyle}" />
            <MenuItem Header="Add folder..." Click="PinFolder_Click"    Style="{StaticResource DockMenuItemStyle}" />
            <MenuItem Header="Add separator" Click="PinSeparator_Click" Style="{StaticResource DockMenuItemStyle}" />
            <Separator Style="{StaticResource DockSeparatorStyle}" />
            <MenuItem Header="Position" Style="{StaticResource DockMenuItemStyle}">
                <MenuItem Header="Bottom" IsCheckable="True" Click="Position_Click" Tag="Bottom" Style="{StaticResource DockMenuItemStyle}" />
                <MenuItem Header="Top"    IsCheckable="True" Click="Position_Click" Tag="Top"    Style="{StaticResource DockMenuItemStyle}" />
                <MenuItem Header="Left"   IsCheckable="True" Click="Position_Click" Tag="Left"   Style="{StaticResource DockMenuItemStyle}" />
                <MenuItem Header="Right"  IsCheckable="True" Click="Position_Click" Tag="Right"  Style="{StaticResource DockMenuItemStyle}" />
            </MenuItem>
            <MenuItem Header="Auto-hide" IsCheckable="True" Tag="AutoHide" Click="AutoHide_Click" Style="{StaticResource DockMenuItemStyle}" />
            <MenuItem Header="Lock dock" IsCheckable="True" Tag="Lock"     Click="Lock_Click"     Style="{StaticResource DockMenuItemStyle}" />
            <MenuItem Header="Start with Windows" IsCheckable="True" Tag="AutoStart" Click="AutoStart_Click" Style="{StaticResource DockMenuItemStyle}" />
            <Separator Style="{StaticResource DockSeparatorStyle}" />
            <MenuItem Header="About DockXI" Click="About_Click" Style="{StaticResource DockMenuItemStyle}" />
            <MenuItem Header="Quit DockXI"  Click="Quit_Click"  Style="{StaticResource DockMenuItemStyle}" />
        </ContextMenu>
    </Window.Resources>

    <!-- BorderThickness=0 + Snap/UseLayoutRounding => no rounded-corner hairline.
         AllowDrop=True + DragEnter/Drop on Border so external file-drop works
         even when the dock is empty (ItemsControl has no children → no hit area). -->
    <Border x:Name="DockPlate"
            CornerRadius="10"
            Background="#E8202020"
            BorderBrush="#1AFFFFFF"
            BorderThickness="1"
            Padding="{Binding ElementName=DockWindow, Path=PlatePadding}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True"
            ClipToBounds="True"
            RenderTransformOrigin="0.5,1"
            AllowDrop="True"
            DragEnter="DockPlate_DragEnter"
            DragOver="DockPlate_DragOver"
            DragLeave="DockPlate_DragLeave"
            Drop="DockPlate_Drop">
        <Border.ContextMenu>
            <StaticResource ResourceKey="DockMenu" />
        </Border.ContextMenu>
        <Border.RenderTransform>
            <!-- Auto-hide shrink/grow lives on the BORDER, not the inner
                 Grid: that way the rounded plate, padding, and tile icons
                 all scale as ONE rigid unit. Animating Window.Width/Height
                 to do the same job goes through Win32 SetWindowPos and
                 stutters relative to the WPF-render-thread ScaleTransform —
                 they desync visibly. Origin is reset per dock edge in
                 PositionAtScreenEdge. -->
            <ScaleTransform x:Name="PlateScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>

        <Grid x:Name="DockContent"
              MinWidth="{Binding ElementName=DockWindow, Path=DockMinWidth}"
              MinHeight="{Binding ElementName=DockWindow, Path=DockMinHeight}">
            <!-- Overflow scrolling: the window's long axis is clamped to the
                 monitor work area (MaxWidth/MaxHeight set per edge in
                 PositionAtScreenEdge). When tiles exceed that, this
                 ScrollViewer takes over — scrollbars stay hidden and the
                 mouse wheel drives the offset (TilesScroller_PreviewMouseWheel
                 maps wheel → horizontal offset on Top/Bottom docks). Which
                 axis may scroll is swapped per edge in PositionAtScreenEdge.
                 CanContentScroll defaults to false → smooth pixel scrolling. -->
            <ScrollViewer x:Name="TilesScroller"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          PanningMode="Both"
                          Focusable="False"
                          Background="Transparent"
                          PreviewMouseWheel="TilesScroller_PreviewMouseWheel">
                <ItemsControl x:Name="TilesHost"
                          ItemsSource="{Binding ElementName=DockWindow, Path=PinnedItems}"
                          Background="Transparent"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          dd:DragDrop.IsDragSource="True"
                          dd:DragDrop.IsDropTarget="True"
                          dd:DragDrop.DragHandler="{Binding ElementName=DockWindow, Path=DragHandler}"
                          dd:DragDrop.DropHandler="{Binding ElementName=DockWindow, Path=DropHandler}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="{Binding ElementName=DockWindow, Path=ItemsOrientation}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="TileSlot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <!-- Scale used for subtle pop-in (new tile pinned) and
                                         shrink-out (tile removed). Starts at 0.75 so the
                                         entrance is a gentle nudge, not a big "growth". -->
                                    <ScaleTransform x:Name="TileScale" ScaleX="0.75" ScaleY="0.75" />
                                    <!-- Translate used by code-behind push-aside (reorder gap). -->
                                    <TranslateTransform x:Name="TileTranslate" X="0" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Grid.Triggers>
                                <!-- Pop-in: scale 0.75 → 1.0 with tiny overshoot. Slower
                                     duration (450ms) + low amplitude so the icon settles
                                     in gently rather than snapping. -->
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.75" To="1.0" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.2" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TileScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.75" To="1.0" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.2" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                            <StackPanel Orientation="{Binding ElementName=DockWindow, Path=TileWrapOrientation}"
                                        FlowDirection="{Binding ElementName=DockWindow, Path=TileFlowDirection}">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Style="{StaticResource TileButtonStyle}"
                                            Click="Tile_Click"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTipService.InitialShowDelay="100"
                                            ToolTipOpening="Tile_ToolTipOpening"
                                            Visibility="{Binding IconVisibility}">
                                        <Button.ToolTip>
                                            <ToolTip Content="{Binding DisplayName}"
                                                     Style="{StaticResource TooltipOverlayStyle}" />
                                        </Button.ToolTip>
                                        <Button.ContextMenu>
                                            <StaticResource ResourceKey="DockMenu" />
                                        </Button.ContextMenu>
                                        <Button.RenderTransform>
                                            <TranslateTransform Y="0" />
                                        </Button.RenderTransform>
                                        <Image Source="{Binding IconSource}"
                                               Width="40" Height="40"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="{Binding IsBroken, Converter={StaticResource BoolToOpacityConverter}}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Button>
                                    <!-- Separator visual: thin vertical bar for horizontal dock, horizontal bar for vertical dock.
                                         Same hit area as a normal tile so drag-reorder and drag-out-to-delete behave identically. -->
                                    <Border Background="Transparent"
                                            Width="{Binding ElementName=DockWindow, Path=SeparatorOuterWidth}"
                                            Height="{Binding ElementName=DockWindow, Path=SeparatorOuterHeight}"
                                            Margin="0"
                                            Visibility="{Binding SeparatorVisibility}">
                                        <Border.ContextMenu>
                                            <StaticResource ResourceKey="DockMenu" />
                                        </Border.ContextMenu>
                                        <Rectangle Width="{Binding ElementName=DockWindow, Path=SeparatorLineWidth}"
                                                   Height="{Binding ElementName=DockWindow, Path=SeparatorLineHeight}"
                                                   Fill="#55FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <!-- Broken-target badge: red circle with ! at top-right -->
                                    <Border Background="#C42B1C"
                                            CornerRadius="9"
                                            Width="14" Height="14"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-2,-2,0"
                                            BorderBrush="#202020" BorderThickness="2"
                                            Visibility="{Binding IsBroken, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="!" Foreground="White"
                                                   FontSize="9" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,-1,0,0" />
                                    </Border>
                                    <!-- Running-app dot — OVERLAY inside the icon Grid (anchored bottom-
                                         centre with negative margin) so it visually sits below the icon
                                         WITHOUT adding a 7-px child to the outer StackPanel. Otherwise
                                         running tiles would be 7 px taller than non-running ones, forcing
                                         the dock to grow and leaving a permanent bottom gap on non-running
                                         tiles. -->
                                    <Ellipse Width="5" Height="5"
                                             Fill="#0078D4"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,0,-6"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <Rectangle x:Name="InsertBar"
                       Width="1"
                       Fill="#E0FFFFFF"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Stretch"
                       Visibility="Collapsed"
                       IsHitTestVisible="False">
                <!-- Width/Height + Alignment + Translate are reconfigured by
                     ShowInsertBar() depending on dock orientation: vertical
                     line for Top/Bottom dock, horizontal line for Left/Right. -->
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="InsertBarT" X="0" Y="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </Border>
</Window>
