<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>DockXI.UI</RootNamespace>
    <AssemblyName>DockXI</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Portable single-file publish settings — only activate during Release
       publish so Debug builds stay fast. Run from the project folder:
         dotnet publish -c Release
       or right-click the project in VS → Publish (target = Folder).
       Output lands at:
         bin\x64\Publish\DockXI-v<version>-<rid>\DockXI.exe
         bin\x64\Publish\DockXI-v<version>-<rid>.zip
       — version + RID are baked into the folder/zip name, so successive
       version builds sit side-by-side under Publish\ without collision. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)bin\x64\Publish\DockXI-v$(Version)-$(RuntimeIdentifier)\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" Condition="Exists('Assets\icon.ico')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DockXI.Core\DockXI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Central Package Management (Directory.Packages.props) pins versions —
         PackageReference must NOT carry Version here. -->
    <PackageReference Include="gong-wpf-dragdrop" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <!-- After Release publish, zip the output folder so it's ready to upload
       as a release asset. Sits next to the unzipped folder inside
       bin\x64\Publish\ — matches Steady's release layout. Release\ stays
       around so incremental rebuilds + local Release-config testing work. -->
  <Target Name="ZipPublishOutput" AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PublishRoot>$(MSBuildThisFileDirectory)bin\x64\Publish\</PublishRoot>
      <ZipFile>$(PublishRoot)DockXI-v$(Version)-$(RuntimeIdentifier).zip</ZipFile>
    </PropertyGroup>
    <MakeDir Directories="$(PublishRoot)" />
    <Delete Files="$(ZipFile)" />
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(ZipFile)" />
    <Message Text="Zipped release: $(ZipFile)" Importance="high" />
  </Target>

</Project>
